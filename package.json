{
  "name": "decky-recorder",
  "version": "0.4.7",
  "description": "This plugin allows you to make screencaptures directly on the Steam Deck, without an external capture card!",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
