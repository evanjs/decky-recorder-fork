    "url": "git+https://github.com/SDH-Stewardship/decky-recorder-fork.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "marissa999/safijari/evanjs",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/SDH-Stewardship/decky-recorder-fork/issues"
  },
  "homepage": "https://github.com/SDH-Stewardship/decky-recorder-fork",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "rollup-plugin-import-assets": "^1.1.1",
    "shx": "^0.3.4",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "decky-recorder": "link:",
